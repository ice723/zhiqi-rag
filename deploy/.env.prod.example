# ============================================================
# 生产环境变量模板（docker compose 使用）
# 复制为 deploy/.env.prod 后填写；.env.prod 不要提交到 git
# 所有 <...> 都是需要你确认后替换的占位符
# ============================================================

# ---------- 推理后端 ----------
# siliconflow：CPU 云端（默认）；local_gpu：切回 GPU 自定义 HTTP 服务
INFERENCE_BACKEND=siliconflow

# ============================================================
# 硅基流动（API Key 由你提供，禁止写死在代码里）
# ============================================================
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_MIN_INTERVAL=0

RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=60
RERANK_MAX_RETRIES=3
RERANK_TOP_N=0

LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-8B
LLM_DEFAULT_TEMPERATURE=0.1
LLM_ENABLE_THINKING=0
ITEM_MODEL=

# ============================================================
# 阿里云百炼（图片理解 + MCP 联网搜索），沿用现有 Key
# ============================================================
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=
VL_MODEL=qwen3-vl-plus
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
WEB_SEARCH_ENABLED=1

# ============================================================
# MinerU（PDF 解析）
# ============================================================
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4

# ============================================================
# 运行目录（容器内路径，对应 compose 的挂载卷）
# ============================================================
DATA_BASED_ROOT_DIR=/app/output
MD_ROOT_DIR=/app/temp-files/

# ============================================================
# Milvus（容器内通过服务名访问，compose 中也会覆盖）
# ============================================================
MILVUS_URL=http://milvus:19530
CHUNKS_COLLECTION=kb_chunks_v2
ITEM_NAME_COLLECTION=kb_item_names_v2
MILVUS_METRIC_TYPE=COSINE

# ============================================================
# MongoDB
# 密码请与下方 MONGO_ROOT_PASSWORD 保持一致；含特殊字符需 URL 编码
# ============================================================
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=<修改为强密码>
MONGO_URL=mongodb://root:<修改为强密码>@mongodb:27017
MONGO_DB_NAME=kb001

# ============================================================
# MinIO（compose 内使用服务名访问；公网地址供浏览器加载图片）
# ============================================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<修改为强密码>
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=kb01
MINIO_SECURE=false
# 必填：http://<服务器公网IP>:9000，或反向代理后的 https 地址
MINIO_PUBLIC_BASE_URL=http://<服务器公网IP>:9000

# ============================================================
# 统一 FastAPI 服务
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOW_ORIGINS=*

# ============================================================
# 可选：切回 GPU 本地推理时再打开
# ============================================================
# INFERENCE_BACKEND=local_gpu
# BGE_M3_URL=http://<GPU服务器A>:8101/v1/embeddings
# BGE_RERANKER_URL=http://<GPU服务器A>:8102/v1/rerank
# LLM_API_BASE=http://<GPU服务器B>:8100/v1
# LLM_API_KEY=sk-any
