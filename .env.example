# ======================
# 推理后端开关
# ======================
# siliconflow（默认，CPU 云端部署）| local_gpu（切回 GPU 自定义服务）
INFERENCE_BACKEND=siliconflow

# ======================
# 硅基流动（Embedding / Rerank / LLM）
# ======================
# 三个 Key 可以填同一个；也可以分别填 EMBEDDING_API_KEY / RERANK_API_KEY / LLM_API_KEY 覆盖
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---- Embedding ----
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3
# 批次之间的最小间隔（秒），用于压限流；0 表示不等待
EMBEDDING_MIN_INTERVAL=0

# ---- Rerank ----
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT=60
RERANK_MAX_RETRIES=3
# 0 表示全部文档参与打分
RERANK_TOP_N=0

# ---- LLM（对话 + 信息抽取）----
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-8B
LLM_DEFAULT_TEMPERATURE=0.1
# Qwen3 是否开启思考模式（0/1）；开启后 JSON 抽取更容易被思维链干扰
LLM_ENABLE_THINKING=0
# 如需完全自定义 extra_body，填 JSON，例如 {"enable_thinking": false}
# LLM_EXTRA_BODY={"enable_thinking": false}
ITEM_MODEL=

# ======================
# 阿里云百炼 DashScope（视觉理解 + MCP 联网搜索）
# ======================
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VL_API_KEY=
VL_MODEL=qwen3-vl-plus
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
WEB_SEARCH_ENABLED=1

# ======================
# MinerU API（PDF 解析）
# ======================
MINERU_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4

# ======================
# 本地目录
# ======================
# 上传文件与解析中间产物的根目录
DATA_BASED_ROOT_DIR=/data/kb/output
# Markdown / 临时文件目录
MD_ROOT_DIR=/data/kb/temp-files/

# ======================
# Milvus
# ======================
MILVUS_URL=http://127.0.0.1:19530
# 使用 2.5+ 的新集合（BM25 Function 与旧集合不兼容，换名避免冲突）
CHUNKS_COLLECTION=kb_chunks_v2
ITEM_NAME_COLLECTION=kb_item_names_v2
MILVUS_METRIC_TYPE=COSINE

# ======================
# MongoDB
# ======================
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=kb001

# ======================
# MinIO
# ======================
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=kb01
MINIO_SECURE=false
# 浏览器访问图片用的对外地址；留空则用 http://MINIO_ENDPOINT
# 例：https://kb.example.com/minio 或 http://1.2.3.4:9000
MINIO_PUBLIC_BASE_URL=

# ======================
# FastAPI
# ======================
# 统一服务监听地址与端口
APP_HOST=0.0.0.0
APP_PORT=8000
# 允许跨域的前端来源，逗号分隔，* 表示全部
CORS_ALLOW_ORIGINS=*

# ======================
# 可选：切回 GPU 本地推理
# ======================
# INFERENCE_BACKEND=local_gpu
# BGE_M3_URL=http://127.0.0.1:6006/v1/embeddings
# BGE_RERANKER_URL=http://127.0.0.1:6008/v1/rerank
